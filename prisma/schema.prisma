generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String
  role           Role           @default(ADMIN)
  status         UserStatus     @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assignedQuotes QuoteRequest[] @relation("AssignedQuotes")

  @@index([email])
  @@index([role])
}

model Category {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  description         String?
  image               String?
  parentId            String?
  sortOrder           Int            @default(0)
  status              CategoryStatus @default(ACTIVE)
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  canonicalUrl        String?
  ogImage             String?
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  parent              Category?      @relation("CategoryToParent", fields: [parentId], references: [id])
  children            Category[]     @relation("CategoryToParent")
  products            Product[]      @relation("CategoryProducts")
  subcategoryProducts Product[]      @relation("SubcategoryProducts")

  @@index([slug])
  @@index([parentId])
  @@index([status])
  @@index([deletedAt])
  @@index([sortOrder])
}

model Product {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  sku              String              @unique
  productCode      String?
  categoryId       String
  subcategoryId    String?
  shortDescription String?
  description      String?
  material         String
  finish           String?
  weight           String?
  dimensions       String?
  styles           Json?
  specifications   Json?
  featured         Boolean             @default(false)
  sortOrder        Int                 @default(0)
  status           ProductStatus       @default(AVAILABLE)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  canonicalUrl     String?
  ogImage          String?
  publishedAt      DateTime?
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  category         Category            @relation("CategoryProducts", fields: [categoryId], references: [id])
  subcategory      Category?           @relation("SubcategoryProducts", fields: [subcategoryId], references: [id])
  collections      ProductCollection[]
  images           ProductImage[]
  variants         ProductVariant[]
  quoteItems       QuoteItem[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([featured])
  @@index([deletedAt])
  @@index([sortOrder])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  altText    String?
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isFeatured])
  @@index([sortOrder])
}

model ProductVariant {
  id          String        @id @default(cuid())
  productId   String
  size        String?
  finish      String?
  material    String?
  sku         String?       @unique
  variantCode String?
  sortOrder   Int           @default(0)
  status      VariantStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quoteItems  QuoteItem[]

  @@index([productId])
  @@index([sku])
  @@index([status])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Collection {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?
  image          String?
  featured       Boolean             @default(false)
  sortOrder      Int                 @default(0)
  status         CollectionStatus    @default(ACTIVE)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?
  ogImage        String?
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  products       ProductCollection[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([deletedAt])
  @@index([sortOrder])
}

model ProductCollection {
  productId    String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([productId])
  @@index([collectionId])
}

model Customer {
  id             String         @id @default(cuid())
  name           String
  company        String
  email          String
  phone          String
  country        String
  city           String
  businessType   String
  companyWebsite String?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  quoteRequests  QuoteRequest[]

  @@index([email])
  @@index([company])
  @@index([deletedAt])
}

model QuoteRequest {
  id                     String      @id @default(cuid())
  customerId             String
  status                 QuoteStatus @default(NEW)
  notes                  String?
  adminNotes             String?
  assignedAdminId        String?
  message                String?
  companyWebsite         String?
  expectedQuantity       String?
  requiredFinish         String?
  requiredDeliveryDate   String?
  additionalRequirements String?
  submittedDate          DateTime    @default(now())
  deletedAt              DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  items                  QuoteItem[]
  assignedAdmin          User?       @relation("AssignedQuotes", fields: [assignedAdminId], references: [id])
  customer               Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([assignedAdminId])
  @@index([deletedAt])
  @@index([submittedDate])
}

model QuoteItem {
  id               String          @id @default(cuid())
  quoteRequestId   String
  productId        String
  variantId        String?
  selectedFinish   String?
  selectedSize     String?
  selectedMaterial String?
  quantity         Int             @default(1)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product          Product         @relation(fields: [productId], references: [id])
  quoteRequest     QuoteRequest    @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([quoteRequestId])
  @@index([productId])
  @@index([variantId])
}

model SiteSettings {
  id            String   @id @default("default")
  companyName   String   @default("SB PATTERN WORKS")
  logo          String?
  email         String?  @default("Sales@sbpatternworks.com")
  phone         String?  @default("+91 (120) 456-7890")
  whatsapp      String?  @default("+91 (120) 456-7890")
  address       String?  @default("E-41 CDF CHHERAT, INDUSTRIAL AREA CDF, ALIGARH, UTTAR PRADESH 202001, India")
  googleMapUrl  String?
  socialLinks   Json?
  seoDefaults   Json?
  footerContent Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String?
  content        String
  featuredImage  String?
  imageAlt       String?
  category       String?
  tags           Json?
  author         String?        @default("SB Pattern Works")
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?
  readingTime    String?
  featured       Boolean        @default(false)
  publishDate    DateTime?
  status         BlogPostStatus @default(DRAFT)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([deletedAt])
  @@index([publishDate])
}

model GalleryAlbum {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  description    String?
  category       String?       @default("Manufacturing")
  projectType    String?
  featuredImage  String?
  sortOrder      Int           @default(0)
  status         GalleryStatus @default(PUBLISHED)
  deletedAt      DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          GalleryItem[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([deletedAt])
}

model GalleryItem {
  id        String       @id @default(cuid())
  albumId   String
  url       String
  title     String?
  altText   String?
  caption   String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([sortOrder])
}

model CustomCraftRequest {
  id              String                  @id @default(cuid())
  referenceNo     String                  @unique
  name            String
  companyName     String?
  email           String
  contactNumber   String
  address         String?
  city            String
  state           String
  country         String
  zipCode         String?
  purpose         String
  customPurpose   String?
  metals          Json
  customMetal     String?
  finishType      String
  selectedFinish  String?
  expectedQuantity String?
  deliveryDate    String?
  description     String
  status          CustomCraftStatus       @default(NEW)
  internalNotes   String?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  attachments     CustomCraftAttachment[]

  @@index([referenceNo])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

model CustomCraftAttachment {
  id        String             @id @default(cuid())
  requestId String
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int?
  createdAt DateTime           @default(now())
  request   CustomCraftRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_EXECUTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProductStatus {
  AVAILABLE
  CUSTOM_ORDER
  DISCONTINUED
  PUBLISHED
  DRAFT
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum CollectionStatus {
  ACTIVE
  DRAFT
}

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CustomCraftStatus {
  NEW
  REVIEWED
  QUOTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  ARCHIVED
}
